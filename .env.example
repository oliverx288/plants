# Copia este archivo a .env y rellena los valores. .env NO se sube a git.

# Frontend (públicas por diseño; la seguridad la aplica RLS en la base de datos)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# --- Solo para `npm run seed`, en TU máquina ---------------------------------
# NUNCA con prefijo VITE_ (se incrustaría en el bundle) y nunca en el frontend ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Contraseñas de los usuarios de prueba (mínimo 12 caracteres). Son credenciales de DEMO.
SEED_AGENT_PASSWORD=
SEED_EDITOR_PASSWORD=

# Opcional: correos de los usuarios de prueba (por defecto, dominio inventado .test).
# SEED_AGENT_EMAIL=lucia@velia-demo.test
# SEED_EDITOR_EMAIL=nuria@velia-demo.test
